---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';
import { getArticles, getAlternates, articlePath, readingMinutes } from '../../lib/articles';
import { parseEntryId, visibleLocales } from '../../lib/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    visibleLocales.map(async (locale) => {
      const articles = await getArticles(locale);
      const published = articles.filter((a) => !a.data.draft);
      return articles.map((entry) => {
        // Published articles only link to published neighbours; drafts see everything.
        const list = entry.data.draft ? articles : published;
        const index = list.indexOf(entry);
        return {
          params: { locale, slug: parseEntryId(entry.id).slug },
          props: { entry, locale, prev: list[index - 1], next: list[index + 1] },
        };
      });
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { entry, locale, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const alternates = await getAlternates(entry);

const toNav = (a: typeof prev) =>
  a ? { title: a.data.title, path: articlePath(a) } : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  path={articlePath(entry)}
  alternates={alternates}
  updated={entry.data.updated}
  tags={entry.data.tags}
  draft={entry.data.draft}
  readingMinutes={readingMinutes(entry)}
  headings={headings}
  prev={toNav(prev)}
  next={toNav(next)}
>
  {/* Components an .mdx article may use without importing them itself. */}
  <Content components={{ Callout }} />
</ArticleLayout>
