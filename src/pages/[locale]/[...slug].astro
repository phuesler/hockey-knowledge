---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';
import { getArticles, getAlternates, articlePath, readingMinutes } from '../../lib/articles';
import { parseEntryId, publishedLocales } from '../../lib/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    publishedLocales.map(async (locale) => {
      const articles = await getArticles(locale);
      return articles.map((entry, index) => ({
        params: { locale, slug: parseEntryId(entry.id).slug },
        props: {
          entry,
          locale,
          prev: articles[index - 1],
          next: articles[index + 1],
        },
      }));
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { entry, locale, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const alternates = await getAlternates(entry);

const toNav = (a: typeof prev) =>
  a ? { title: a.data.title, path: articlePath(a) } : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  path={articlePath(entry)}
  alternates={alternates}
  updated={entry.data.updated}
  tags={entry.data.tags}
  readingMinutes={readingMinutes(entry)}
  headings={headings}
  prev={toNav(prev)}
  next={toNav(next)}
>
  {/* Components an .mdx article may use without importing them itself. */}
  <Content components={{ Callout }} />
</ArticleLayout>
