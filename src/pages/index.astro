---
// There is no server to issue a redirect on a static host, so the root page is a
// meta-refresh to the default locale plus a visible link as a fallback.
import { href } from '../lib/href';
import { defaultLocale, t } from '../lib/i18n';

const target = href(`/${defaultLocale}/`);
const s = t(defaultLocale);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{s.siteName}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Weiter zu <a href={target}>{s.siteName}</a>.</p>
  </body>
</html>
