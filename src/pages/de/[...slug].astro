---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';
import { getArticles, articlePath, readingMinutes } from '../../lib/articles';
import { parseEntryId } from '../../lib/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const articles = await getArticles('de');
  return articles.map((entry, index) => ({
    params: { slug: parseEntryId(entry.id).slug },
    props: {
      entry,
      prev: articles[index - 1],
      next: articles[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

const toNav = (a: typeof prev) =>
  a ? { title: a.data.title, path: articlePath(a) } : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  path={articlePath(entry)}
  updated={entry.data.updated}
  tags={entry.data.tags}
  readingMinutes={readingMinutes(entry)}
  headings={headings}
  prev={toNav(prev)}
  next={toNav(next)}
>
  {/* Components an .mdx article may use without importing them itself. */}
  <Content components={{ Callout }} />
</ArticleLayout>
