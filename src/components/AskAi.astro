---
import Prompt from './Prompt.astro';
import { absoluteUrl, href } from '../lib/href';
import { localeFromUrl, t } from '../lib/i18n';

/**
 * Points an AI assistant at the site: a ready-made prompt with the URL of
 * /<locale>/llms-full.txt, plus the file itself for assistants that cannot open links.
 * Used in the "Lernen mit KI" article, which explains what to ask next.
 */
const locale = localeFromUrl(Astro.url);
const s = t(locale).askAi;
const file = `/${locale}/llms-full.txt`;
const prompt = s.prompt.replace('{url}', absoluteUrl(file, Astro.site));
---

<div id="ask-ai">
  <Prompt>{prompt}</Prompt>
  <p>
    <a href={href(file)} download>{s.download}</a>. {s.downloadNote}
  </p>
</div>
