---
import { href } from '../lib/href';
import { t, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  tags?: string[];
  readingMinutes: number;
  locale?: Locale;
  /** Hidden unless drafts are shown (see BaseLayout). */
  draft?: boolean;
}

const { title, description, path, tags = [], readingMinutes, locale = 'de', draft = false } = Astro.props;
const s = t(locale);
---

<li class="card item" data-draft={draft || undefined}>
  <a href={href(path)}>
    {draft && <p class="draft">{s.draft}</p>}
    <h3>{title}</h3>
    <p class="desc">{description}</p>
  </a>
  <p class="foot">
    {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    <span class="time">{readingMinutes} {s.readingTimeShort}</span>
  </p>
</li>

<style>
  .item {
    padding: var(--s-5);
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .item:hover {
    border-color: var(--c-brand);
    transform: translateY(-2px);
  }
  .item > a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .draft {
    display: inline-block;
    margin-block-end: var(--s-2);
    padding: 0 var(--s-2);
    background: var(--c-warn-soft);
    color: var(--c-warn);
    border: 1px solid var(--c-warn);
    border-radius: var(--radius);
    font-size: var(--t-sm);
    font-weight: 700;
  }
  h3 {
    font-size: var(--t-h3);
    color: var(--c-brand);
    letter-spacing: -0.01em;
  }
  .desc {
    margin-block-start: var(--s-2);
    color: var(--c-text-muted);
  }
  .foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }
  .time {
    margin-inline-start: auto;
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }
</style>
