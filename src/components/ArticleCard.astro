---
import { href } from '../lib/href';

interface Props {
  title: string;
  description: string;
  path: string;
  tags?: string[];
  readingMinutes: number;
}

const { title, description, path, tags = [], readingMinutes } = Astro.props;
---

<li class="card item">
  <a href={href(path)}>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
  </a>
  <p class="foot">
    {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    <span class="time">{readingMinutes} Min.</span>
  </p>
</li>

<style>
  .item {
    padding: var(--s-5);
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .item:hover {
    border-color: var(--c-brand);
    transform: translateY(-2px);
  }
  .item > a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  h3 {
    font-size: var(--t-h3);
    color: var(--c-brand);
    letter-spacing: -0.01em;
  }
  .desc {
    margin-block-start: var(--s-2);
    color: var(--c-text-muted);
  }
  .foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }
  .time {
    margin-inline-start: auto;
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }
</style>
