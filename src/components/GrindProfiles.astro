---
/**
 * Cross-sections of three grind profiles: classic round hollow, flat bottom V
 * (the trapezoid) and a flat-bottomed hollow with round flanks. Static SVG on
 * purpose — the graphic carries the section, so it must be there without
 * JavaScript.
 *
 * Geometry per blade: the blade runs from x=25 to x=75 with its edges at y=75;
 * the viewBox crops to its lower part. The round hollow is an arc of radius 30
 * centred at (50,91.6), about 13 units deep. The flat-bottom variant uses the
 * same arc but is cut off at y=66. Depths are hugely exaggerated, like in the
 * hollow explorer.
 */
import { localeFromUrl } from '../lib/i18n';

const de = {
  caption: 'Die Kufe von vorn gesehen (Rille stark vergrössert)',
  profiles: {
    hollow: {
      name: 'Hohlschliff',
      label: 'Kufe von vorn mit runder Rille zwischen den Kanten',
      text: 'Runde Rille. Der Klassiker, den jeder Schleifer kann.',
    },
    fbv: {
      name: 'Flat Bottom V',
      label: 'Kufe von vorn mit trapezförmiger Rille: flacher Boden, schräge Seiten',
      text: 'Flacher Boden, schräge Seiten. Sieht aus wie ein Trapez.',
    },
    'flat-hollow': {
      name: 'Flacher Boden, runde Seiten',
      label: 'Kufe von vorn mit runder Rille, die unten abgeflacht ist',
      text: 'Seiten wie beim Hohlschliff, unten abgeflacht (z. B. FIRE).',
    },
  },
};

const en: typeof de = {
  caption: 'The blade seen from the front (groove heavily enlarged)',
  profiles: {
    hollow: {
      name: 'Hollow',
      label: 'Blade from the front with a round groove between the edges',
      text: 'Round groove. The classic that every sharpener can do.',
    },
    fbv: {
      name: 'Flat Bottom V',
      label: 'Blade from the front with a trapezoid groove: flat bottom, slanted sides',
      text: 'Flat bottom, slanted sides. Looks like a trapezoid.',
    },
    'flat-hollow': {
      name: 'Flat bottom, round sides',
      label: 'Blade from the front with a round groove that is flattened at the bottom',
      text: 'Sides like a hollow, flattened at the bottom (e.g. FIRE).',
    },
  },
};

const s = { de, en }[localeFromUrl(Astro.url)];

const profiles = [
  {
    id: 'hollow',
    blade: 'M25 30 H75 V75 A30 30 0 0 0 25 75 Z',
  },
  {
    id: 'fbv',
    blade: 'M25 30 H75 V75 L62 62 H38 L25 75 Z',
  },
  {
    id: 'flat-hollow',
    blade: 'M25 30 H75 V75 A30 30 0 0 0 65.6 66 H34.4 A30 30 0 0 0 25 75 Z',
  },
] as const;
---

<figure class="grinds">
  <figcaption>{s.caption}</figcaption>

  <ul>
    {
      profiles.map((p) => (
        <li>
          <svg viewBox="8 36 84 46" role="img" aria-label={s.profiles[p.id].label}>
            <line x1="6" y1="75.5" x2="94" y2="75.5" class="ice" />
            <path d={p.blade} class="blade" />
            <circle cx="25" cy="75" r="3" class="edge" />
            <circle cx="75" cy="75" r="3" class="edge" />
          </svg>
          <p class="name">{s.profiles[p.id].name}</p>
          <p class="text">{s.profiles[p.id].text}</p>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .grinds {
    margin: var(--s-6) 0;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  figcaption {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    font-weight: 700;
    margin-bottom: var(--s-4);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 34rem) {
    ul { gap: var(--s-5); }
  }

  svg {
    display: block;
    width: 100%;
    max-width: 8rem;
    margin-inline: auto;
    background: var(--c-surface-2);
    border-radius: var(--radius);
  }

  .ice {
    stroke: var(--c-ice);
    stroke-width: 3;
  }
  .blade {
    fill: var(--c-steel);
    stroke: var(--c-text-muted);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .edge { fill: var(--c-accent); }

  .name {
    margin: var(--s-3) 0 var(--s-1);
    hyphens: auto;
    font-weight: 700;
    text-align: center;
    text-wrap: balance;
  }
  .text {
    margin: 0;
    hyphens: auto;
    font-size: var(--t-sm);
    color: var(--c-text-muted);
    text-align: center;
    text-wrap: balance;
  }
</style>
