---
/**
 * A prompt to copy into an AI assistant: the text in a box, with a copy button. The button
 * only appears when the clipboard API is there; the text stays selectable either way.
 *
 *   <Prompt>Stell mir fünf Fragen zum Artikel „Regeln“.</Prompt>
 *
 * The text is the slot, so it can be written straight into an article. plaintext.ts turns
 * it into a quote for the llms-full.txt files.
 */
import { t, localeFromUrl } from '../lib/i18n';

const s = t(localeFromUrl(Astro.url)).askAi;
---

<div class="prompt-box">
  <p class="prompt-text"><slot /></p>
  <button type="button" class="copy" data-copied={s.copied} hidden>{s.copy}</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.prompt-box .copy')) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    const label = button.textContent;
    button.addEventListener('click', async () => {
      const text = button.parentElement?.querySelector('.prompt-text')?.textContent?.trim() ?? '';
      await navigator.clipboard.writeText(text);
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 2000);
    });
  }
</script>

<style>
  .prompt-box {
    margin-block: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-inline-start: 4px solid var(--c-accent);
    border-radius: var(--radius);
    background: var(--c-accent-soft);
  }
  .prompt-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    overflow-wrap: anywhere;
  }
  .copy {
    margin-block-start: var(--s-3);
    min-height: 2.75rem;
    padding: var(--s-1) var(--s-3);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--c-accent);
    background: var(--c-surface);
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .copy:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
</style>
