---
/**
 * Side views of a laced skate for the lacing section. Three variants:
 *
 *   eyelets – tight over forefoot and instep, looser at the top, top eyelet left free
 *   knee    – the knee bend: laced too tight at the top the knee stays back (faint),
 *             looser at the top the boot gives and the knee comes over the toes
 *   wrap    – laces wrapped around the ankle (don't) next to the ends tucked under
 *             the hockey sock (do)
 *
 * Static SVG, so it works without JavaScript. The skate faces right (toe on the
 * right). The boot is split into a foot part and a shaft part; the shaft rotates
 * around the ankle O, so the knee variant can show the boot flexing forward.
 * Proportions are simplified, the flex is exaggerated.
 */
interface Props {
  variant: 'eyelets' | 'knee' | 'wrap';
}

import { localeFromUrl } from '../lib/i18n';

const { variant } = Astro.props;

const de = {
  captions: {
    eyelets: 'Unten fest, oben lockerer',
    knee: 'Die Kniebeuge: das Knie muss nach vorn',
    wrap: 'Lange Enden: wohin damit?',
  },
  tight: 'fest',
  tightWhere: 'Vorfuss und Rist',
  loose: 'lockerer',
  free: 'oberste Öse frei',
  eyeletsLabel:
    'Schlittschuh von der Seite. Die unteren fünf Ösen über Vorfuss und Rist sind fest geschnürt, die drei darüber lockerer, die Schleife sitzt an der zweitobersten Öse. Die oberste Öse bleibt frei.',
  tooTight: 'Oben zu fest: Das Knie bleibt hinten',
  looser: 'Oben lockerer: Das Knie kommt nach vorn',
  toes: 'Über den Zehen',
  kneeLabel:
    'Unterschenkel und Schlittschuh von der Seite. Blass gezeichnet: oben zu fest gebunden, der Schuh gibt nicht nach und das Knie bleibt fast senkrecht über dem Knöchel. Kräftig gezeichnet: oben lockerer, der Schuh neigt sich nach vorn und das Knie kommt bis über die Zehen.',
  kneeText:
    'In der Fahrposition kommt das Knie nach vorn, bis etwa über die Zehen. Dafür muss der Schuh oben nachgeben. Ist er dort zu fest gebunden, bleibt das Knie hinten, und das Kind steht zu aufrecht.',
  bad: 'Nicht so',
  good: 'So',
  wrapped: 'Um die Knöchel gewickelt',
  wrappedText: 'Der Schuh wird oben steif. Die Knöchel können sich kaum noch bewegen.',
  wrappedLabel:
    'Oberer Teil eines Schlittschuhs von der Seite. Die Schnürsenkel sind zweimal um den Schuh oben am Knöchel gewickelt.',
  tucked: 'Enden unter die Stutzen',
  tuckedText: 'Die Schleife bleibt vorn, die Enden verschwinden unter den Stutzen. Die Knöchel bleiben beweglich, und nichts hängt aufs Eis.',
  tuckedLabel:
    'Oberer Teil eines Schlittschuhs von der Seite. Die Schleife sitzt vorn, die langen Enden führen nach oben und verschwinden unter dem Stutzen.',
};

const en: typeof de = {
  captions: {
    eyelets: 'Tight at the bottom, looser at the top',
    knee: 'The knee bend: the knee has to come forward',
    wrap: 'Long ends: where do they go?',
  },
  tight: 'tight',
  tightWhere: 'forefoot and instep',
  loose: 'looser',
  free: 'top eyelet left free',
  eyeletsLabel:
    'Skate from the side. The bottom five eyelets over the forefoot and instep are laced tightly, the three above them more loosely, with the bow at the second eyelet from the top. The top eyelet stays free.',
  tooTight: 'Too tight at the top: the knee stays back',
  looser: 'Looser at the top: the knee comes forward',
  toes: 'Above the toes',
  kneeLabel:
    'Lower leg and skate from the side. Drawn faintly: laced too tight at the top, the boot doesn’t give and the knee stays almost straight above the ankle. Drawn strongly: looser at the top, the boot leans forward and the knee comes over the toes.',
  kneeText:
    'In the skating position the knee comes forward to roughly above the toes. For that, the boot has to give at the top. If it’s laced too tightly there, the knee stays back and your child stands too upright.',
  bad: 'Don’t',
  good: 'Do',
  wrapped: 'Wrapped around the ankles',
  wrappedText: 'The top of the boot goes stiff. The ankles can hardly move.',
  wrappedLabel:
    'Top part of a skate from the side. The laces are wrapped twice around the top of the boot at the ankle.',
  tucked: 'Ends under the socks',
  tuckedText: 'The bow stays at the front, the ends disappear under the hockey sock. The ankles stay mobile, and nothing hangs down onto the ice.',
  tuckedLabel:
    'Top part of a skate from the side. The bow sits at the front, the long ends lead upwards and disappear under the hockey sock.',
};

const s = { de, en }[localeFromUrl(Astro.url)];

type Point = { x: number; y: number };
const pt = (p: Point) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;

// The ankle: the shaft and the shin rotate around it.
const O: Point = { x: 76, y: 124 };

// The front edge of the boot runs from the toe cap (F0) to the top (F1); n points
// forwards, away from the boot, at a right angle to it.
const F0: Point = { x: 156, y: 134 };
const D: Point = { x: -54, y: -78 };
const DLEN = Math.hypot(D.x, D.y);
const n: Point = { x: -D.y / DLEN, y: D.x / DLEN };

/** A point on the front edge at t (0 = toe cap, 1 = top), moved `off` along n. */
const edge = (t: number, off: number): Point => ({
  x: F0.x + t * D.x + off * n.x,
  y: F0.y + t * D.y + off * n.y,
});

// Nine eyelets, numbered from the toe cap up. The lace crosses the tongue between them.
const EYELETS = 9;
const T_FIRST = 0.08;
const T_STEP = (0.95 - T_FIRST) / (EYELETS - 1);
const eyeletT = (i: number) => T_FIRST + i * T_STEP;
const eyelets = Array.from({ length: EYELETS }, (_, i) => edge(eyeletT(i), -7));
const crossing = (i: number) => edge(eyeletT(i) + T_STEP / 2, 5);

/** Zigzag lace from eyelet `from` up to eyelet `to`. */
function lacePath(from: number, to: number) {
  const parts = [`M${pt(eyelets[from])}`];
  for (let i = from; i < to; i++) parts.push(`L${pt(crossing(i))}`, `L${pt(eyelets[i + 1])}`);
  return parts.join(' ');
}

// Tight over forefoot and instep (eyelets 0–4), looser above (4–7), the bow at 7.
const TIGHT_TOP = 4;
const LACED_TOP = 7;
const knot = edge(eyeletT(LACED_TOP) + T_STEP / 2, 6);
const bowLoops = `M${pt(knot)} c8 -14 22 -12 18 -2 Z M${pt(knot)} c14 -2 20 10 10 14 Z`;
const bowTails = `M${pt(knot)} q6 14 2 30 M${pt(knot)} q12 10 16 24`;
const tuckedTails = `M${pt(knot)} q-4 -10 -18 -16 M${pt(knot)} q2 -12 -8 -22`;

// Brackets beside the lacing, parallel to the front edge.
const bracket = (a: number, b: number) =>
  `M${pt(edge(eyeletT(a), 15))} L${pt(edge(eyeletT(a), 20))} L${pt(edge(eyeletT(b), 20))} L${pt(edge(eyeletT(b), 15))}`;
const tightMid = edge((eyeletT(0) + eyeletT(TIGHT_TOP)) / 2, 20);
const looseMid = edge((eyeletT(TIGHT_TOP + 1) + eyeletT(LACED_TOP)) / 2, 20);
const top = eyelets[EYELETS - 1];

// Boot parts. The shaft reaches down into the foot so no gap opens when it flexes.
const foot =
  'M44 164 H172 Q182 162 180 148 Q178 136 156 134 L132 100 L60 112 L42 120 Q38 150 44 164 Z';
const shaft = 'M42 140 L42 100 Q42 76 50 54 L102 56 L132 100 L140 112 L90 150 Z';
const tendon = 'M50 66 Q46 50 40 40 L48 37 Q56 48 60 58 Z';
const tongueFoot = edge(T_FIRST, 8);
const tongueTop = edge(1, 8);
const tongue = `M150 140 L${pt(tongueFoot)} L${pt(tongueTop)} L105 32 Q98 24 86 30 L90 60 Z`;
const holder = 'M42 186 L52 164 H164 L174 186 Z M80 182 Q110 168 140 182 Z';
const steel = 'M36 186 H178 Q182 196 170 198 H44 Q32 196 36 186 Z';
const ICE = 199.5;

// Bands of lace wrapped around the top of the boot.
const band = (y: number) => {
  const front = { x: F0.x + ((F0.y - y) / -D.y) * D.x + 9, y };
  return `M41 ${y - 5} Q80 ${y + 7} ${pt(front)}`;
};

/** Shin and thigh as one thick line: ankle → knee → hip. */
const SHIN = 200;
const THIGH = 110;
function leg(shinDeg: number, thighDeg: number, from = 30) {
  const a = (shinDeg * Math.PI) / 180;
  const start = { x: O.x + from * Math.sin(a), y: O.y - from * Math.cos(a) };
  const knee = { x: O.x + SHIN * Math.sin(a), y: O.y - SHIN * Math.cos(a) };
  const b = (thighDeg * Math.PI) / 180;
  const hip = { x: knee.x - THIGH * Math.cos(b), y: knee.y - THIGH * Math.sin(b) };
  return { d: `M${pt(start)} L${pt(knee)} L${pt(hip)}`, knee };
}
// Knee variant: laced too tight the boot stays put; looser, it flexes forward.
const stiff = { shaft: 0, ...leg(4, 80) };
const flexed = { shaft: 20, ...leg(24, 50) };
const toeLine = flexed.knee.x;
// Wrap variant: the sock starts at the top of the boot, so its hem covers tucked ends.
const standing = leg(6, 80, 66);
---

<figure class="skate-lacing">
  <figcaption>{s.captions[variant]}</figcaption>

  {
    variant === 'eyelets' && (
      <svg viewBox="22 14 270 192" role="img" aria-label={s.eyeletsLabel}>
        <path d={tongue} class="tongue" />
        <path d={foot} class="boot" />
        <path d={shaft} class="boot" />
        <path d={tendon} class="boot" />
        <path d={holder} class="holder" fill-rule="evenodd" />
        <path d={steel} class="steel" />
        <line x1="22" y1={ICE} x2="292" y2={ICE} class="ice" />

        {eyelets.slice(0, LACED_TOP + 1).map((e) => <circle cx={e.x} cy={e.y} r="2.2" class="eyelet" />)}
        <path d={lacePath(0, LACED_TOP)} class="lace" />
        <path d={bowTails} class="lace thin" />
        <path d={bowLoops} class="bow" />
        <circle cx={top.x} cy={top.y} r="2.2" class="eyelet" />
        <circle cx={top.x} cy={top.y} r="7" class="free-ring" />

        <path d={bracket(0, TIGHT_TOP)} class="bracket tight" />
        <text x={tightMid.x + 12} y={tightMid.y + 2} class="label strong tight-text">{s.tight}</text>
        <text x={tightMid.x + 12} y={tightMid.y + 18} class="label">{s.tightWhere}</text>
        <path d={bracket(TIGHT_TOP + 1, LACED_TOP)} class="bracket loose" />
        <text x={looseMid.x + 12} y={looseMid.y + 4} class="label strong loose-text">{s.loose}</text>
        <path d={`M${top.x + 6} ${top.y - 6} L140 36`} class="leader" />
        <text x="144" y="34" class="label strong free-text">{s.free}</text>
      </svg>
    )
  }

  {
    variant === 'knee' && (
      <div class="single">
        <svg viewBox="16 -146 250 352" role="img" aria-label={s.kneeLabel}>
          <defs>
            <marker id="skate-lacing-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 Z" class="head" />
            </marker>
          </defs>

          <g class="ghost">
            <path d={stiff.d} class="leg" />
            <path d={shaft} class="boot" transform={`rotate(${stiff.shaft} ${O.x} ${O.y})`} />
          </g>

          <line x1={toeLine} y1="130" x2={toeLine} y2={flexed.knee.y + 30} class="toe-line" />

          <path d={flexed.d} class="leg" />
          <g transform={`rotate(${flexed.shaft} ${O.x} ${O.y})`}>
            <path d={tongue} class="tongue" />
            <path d={shaft} class="boot" />
            <path d={tendon} class="boot" />
          </g>
          <path d={foot} class="boot" />
          <path d={holder} class="holder" fill-rule="evenodd" />
          <path d={steel} class="steel" />
          <line x1="16" y1={ICE} x2="266" y2={ICE} class="ice" />

          <path
            d={`M${pt({ x: stiff.knee.x, y: stiff.knee.y - 30 })} Q${pt({ x: (stiff.knee.x + flexed.knee.x) / 2 + 6, y: stiff.knee.y - 52 })} ${pt({ x: flexed.knee.x + 4, y: flexed.knee.y - 30 })}`}
            class="arrow"
            marker-end="url(#skate-lacing-head)"
          />
        </svg>
        <ul class="legend">
          <li><span class="swatch stiff" />{s.tooTight}</li>
          <li><span class="swatch flexed" />{s.looser}</li>
          <li><span class="swatch toes" />{s.toes}</li>
        </ul>
        <p class="text">{s.kneeText}</p>
      </div>
    )
  }

  {
    variant === 'wrap' && (
      <div class="pair">
        <div>
          <p class="title">
            <span class="verdict bad">{s.bad}</span>
            {s.wrapped}
          </p>
          <svg viewBox="22 -20 170 170" role="img" aria-label={s.wrappedLabel}>
            <path d={tongue} class="tongue" />
            <path d={foot} class="boot" />
            <path d={shaft} class="boot" />
            {eyelets.map((e) => <circle cx={e.x} cy={e.y} r="2.2" class="eyelet" />)}
            <path d={lacePath(0, EYELETS - 1)} class="lace" />
            <path d={band(78)} class="lace wrapped" />
            <path d={band(90)} class="lace wrapped" />
            <path d={standing.d} class="leg sock" />
            <path d={tendon} class="boot" />
            <path d={holder} class="holder" fill-rule="evenodd" />
          </svg>
          <p class="text">{s.wrappedText}</p>
        </div>
        <div>
          <p class="title">
            <span class="verdict good">{s.good}</span>
            {s.tucked}
          </p>
          <svg viewBox="22 -20 170 170" role="img" aria-label={s.tuckedLabel}>
            <path d={tongue} class="tongue" />
            <path d={foot} class="boot" />
            <path d={shaft} class="boot" />
            {eyelets.map((e) => <circle cx={e.x} cy={e.y} r="2.2" class="eyelet" />)}
            <path d={lacePath(0, LACED_TOP)} class="lace" />
            <path d={tuckedTails} class="lace thin" />
            <path d={standing.d} class="leg sock" />
            <path d={tendon} class="boot" />
            <path d={bowLoops} class="bow" />
            <path d={holder} class="holder" fill-rule="evenodd" />
          </svg>
          <p class="text">{s.tuckedText}</p>
        </div>
      </div>
    )
  }
</figure>

<style>
  .skate-lacing {
    margin: var(--s-6) 0;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  figcaption {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    font-weight: 700;
    margin-bottom: var(--s-4);
  }

  .pair {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 40rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .single {
    max-width: 20rem;
    margin-inline: auto;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
    background: var(--c-surface-2);
    border-radius: var(--radius);
  }
  .pair svg {
    max-width: 20rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-2);
    font-weight: 700;
  }
  .verdict {
    flex: none;
    white-space: nowrap;
    padding: 0 var(--s-2);
    font-size: var(--t-sm);
    border-radius: var(--radius);
    border: 1px solid currentColor;
  }
  .verdict.good {
    color: var(--c-good);
    background: var(--c-good-soft);
  }
  .verdict.bad {
    color: var(--c-brand);
    background: var(--c-brand-soft);
  }
  .legend {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
    font-size: var(--t-sm);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .swatch {
    flex: none;
    width: 1.5rem;
    height: 0.75rem;
    border-radius: 3px;
  }
  .swatch.stiff {
    background: var(--c-text-muted);
    opacity: 0.3;
  }
  .swatch.flexed {
    background: var(--c-signal);
  }
  .swatch.toes {
    height: 0;
    border-top: 2px dashed var(--c-good);
    border-radius: 0;
  }
  .text {
    margin: var(--s-2) 0 0;
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .boot {
    fill: var(--c-text);
  }
  .tongue,
  .holder {
    fill: var(--c-text-muted);
  }
  .steel {
    fill: var(--c-steel);
  }
  .ice {
    stroke: var(--c-ice);
    stroke-width: 4;
  }
  .leg {
    fill: none;
    stroke: var(--c-signal);
    stroke-width: 46;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .leg.sock {
    stroke-linecap: butt;
  }
  .ghost {
    opacity: 0.3;
  }
  .ghost .leg {
    stroke: var(--c-text-muted);
  }
  .ghost .boot {
    fill: var(--c-text-muted);
  }

  .eyelet {
    fill: var(--c-steel);
  }
  .lace {
    fill: none;
    stroke: var(--c-surface);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .lace.thin {
    stroke-width: 2;
  }
  .lace.wrapped {
    stroke-width: 3.5;
  }
  .bow {
    fill: none;
    stroke: var(--c-surface);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .bracket {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .bracket.tight {
    stroke: var(--c-brand);
  }
  .bracket.loose {
    stroke: var(--c-accent);
  }
  .free-ring {
    fill: none;
    stroke: var(--c-good);
    stroke-width: 2.5;
    stroke-dasharray: 3 2;
  }
  .leader {
    fill: none;
    stroke: var(--c-good);
    stroke-width: 1.5;
  }
  .toe-line {
    stroke: var(--c-good);
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }
  .arrow {
    fill: none;
    stroke: var(--c-brand);
    stroke-width: 2.5;
  }
  .head {
    fill: var(--c-brand);
  }

  .label {
    font-family: var(--font-sans);
    fill: var(--c-text-muted);
    font-size: 13px;
  }
  .label.strong {
    fill: var(--c-text);
    font-weight: 700;
  }
  .label.tight-text {
    fill: var(--c-brand);
  }
  .label.loose-text {
    fill: var(--c-accent);
  }
  .label.free-text {
    fill: var(--c-good);
  }
</style>
