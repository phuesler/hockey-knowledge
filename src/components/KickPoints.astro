---
/**
 * Illustrates the three kick point families: where a shaft bends most when a
 * player loads it. Static SVG on purpose — the graphic carries the section, so
 * it must be there without JavaScript.
 *
 * Geometry per stick (viewBox 100 x 250): the shaft runs from (50,12) to
 * (48,218), drawn as a cubic curve whose control points pull the bulge into the
 * zone being shown. The dashed line is the same shaft unloaded.
 */
import { localeFromUrl } from '../lib/i18n';

const de = {
  caption: 'Wo sich der Schaft biegt',
  label: (name: string, where: string) => `Schläger mit ${name}: der Schaft biegt sich ${where}`,
  zones: {
    mid: {
      where: 'in der Mitte',
      text: 'Biegt sich in der Mitte des Schafts. Lädt langsamer, gibt dafür viel Wucht.',
    },
    hybrid: {
      where: 'zwischen Mitte und Kelle',
      text: 'Die Biegezone ist länger und liegt zwischen Mid und Low. Verzeiht am meisten.',
    },
    low: {
      where: 'knapp über der Kelle',
      text: 'Biegt sich knapp über der Kelle. Lädt sehr schnell, braucht aber Technik.',
    },
  },
};

const en: typeof de = {
  caption: 'Where the shaft bends',
  label: (name, where) => `Stick with a ${name}: the shaft bends ${where}`,
  zones: {
    mid: {
      where: 'in the middle',
      text: 'Bends in the middle of the shaft. Loads more slowly, but packs a lot of power.',
    },
    hybrid: {
      where: 'between the middle and the blade',
      text: 'The bending zone is longer and sits between mid and low. The most forgiving.',
    },
    low: {
      where: 'just above the blade',
      text: 'Bends just above the blade. Loads very quickly, but needs good technique.',
    },
  },
};

const s = { de, en }[localeFromUrl(Astro.url)];

const zones = [
  {
    id: 'mid',
    name: 'Mid Kick',
    shaft: 'M50 12 C24 90 24 150 48 218',
    band: { y: 72, height: 70 },
  },
  {
    id: 'hybrid',
    name: 'Hybrid',
    shaft: 'M50 12 C40 110 22 170 48 218',
    band: { y: 108, height: 78 },
  },
  {
    id: 'low',
    name: 'Low Kick',
    shaft: 'M50 12 C50 130 26 188 48 218',
    band: { y: 156, height: 56 },
  },
] as const;
---

<figure class="kickpoints">
  <figcaption>{s.caption}</figcaption>

  <ul>
    {
      zones.map((zone) => (
        <li>
          <svg viewBox="0 0 100 250" role="img" aria-label={s.label(zone.name, s.zones[zone.id].where)}>
            {/* Biegezone */}
            <rect x="10" y={zone.band.y} width="80" height={zone.band.height} rx="8" />
            {/* Schaft ohne Belastung */}
            <path d="M50 12 L48 218" class="ghost" />
            {/* Schaft unter Belastung, plus Kelle */}
            <path d={zone.shaft} class="shaft" />
            <path d="M48 218 L84 226" class="blade" />
          </svg>
          <p class="name">{zone.name}</p>
          <p class="text">{s.zones[zone.id].text}</p>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .kickpoints {
    margin: var(--s-6) 0;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  figcaption {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    font-weight: 700;
    margin-bottom: var(--s-4);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 34rem) {
    ul { gap: var(--s-5); }
  }
  /* .prose spaces consecutive list items (.prose li + li); in a grid that pushes
     columns down. ul > li is needed to outrank it. */
  ul > li {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 7rem;
    margin-inline: auto;
    background: var(--c-surface-2);
    border-radius: var(--radius);
  }

  rect {
    fill: var(--c-accent-soft);
    stroke: var(--c-accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  path {
    fill: none;
    stroke-linecap: round;
  }
  .ghost {
    stroke: var(--c-steel);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }
  .shaft {
    stroke: var(--c-brand);
    stroke-width: 6;
  }
  .blade {
    stroke: var(--c-brand);
    stroke-width: 9;
  }

  .name {
    margin: var(--s-3) 0 var(--s-1);
    font-weight: 700;
    text-align: center;
  }
  .text {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--c-text-muted);
    text-align: center;
    text-wrap: balance;
  }
</style>
