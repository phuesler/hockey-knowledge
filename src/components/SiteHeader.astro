---
import { href } from '../lib/href';
import { t, type Locale } from '../lib/i18n';
import type { Alternate } from '../lib/articles';
import { repoUrl } from '../lib/site';

interface Props {
  locale?: Locale;
  /** Other language versions of the current page; the switcher shows the rest. */
  alternates?: Alternate[];
}
const { locale = 'de', alternates = [] } = Astro.props;
const s = t(locale);
const otherLanguages = alternates.filter((a) => a.locale !== locale);
const home = href(`/${locale}/`);
---

<header class="site-header">
  <div class="wrap wrap-wide bar">
    <a class="brand" href={home} aria-label={s.siteName}>
      <!-- The club crest, same file as the favicon. Decorative: the link's
           aria-label already names the site. -->
      <img class="brand-mark" src={href('/icon-192.png')} alt="" width="44" height="44" />
      <span class="brand-text">
        <strong>{s.brandShort}</strong>
        <small>{s.brandSub}</small>
      </span>
    </a>
    <nav aria-label={s.mainNav}>
      <a class:list={['all', { 'has-lang': otherLanguages.length > 0 }]} href={home}>{s.allArticles}</a>
      {otherLanguages.map((a) => (
        <a
          class="lang"
          href={href(a.path)}
          hreflang={a.locale}
          lang={a.locale}
          title={t(a.locale).languageName}
          aria-label={t(a.locale).languageName}
        >
          {t(a.locale).languageShort}
        </a>
      ))}
      <a class="repo" href={repoUrl} title={s.repoTitle} aria-label={s.repoTitle}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        <span class="repo-label">{s.repoLabel}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-header-bg);
    color: var(--c-header-text);
    border-block-end: 4px solid var(--c-signal);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 3.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  .brand:hover { color: inherit; }
  /* Larger than a plain icon would need: the crest's lettering and player get
     lost below about 44 px. */
  .brand-mark { width: 2.75rem; height: 2.75rem; flex: none; }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    white-space: nowrap;
  }
  .brand-text strong {
    font-size: var(--t-lg);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .brand-text small {
    color: var(--c-header-muted);
    font-size: var(--t-sm);
  }
  nav { display: flex; align-items: center; gap: var(--s-1); }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-header-text);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
    padding: var(--s-2);
    border-radius: var(--radius);
    white-space: nowrap;
  }
  @media (min-width: 30rem) {
    nav a { padding-inline: var(--s-3); }
  }
  /* With a language link the bar no longer fits at 360 px; the logo and the
     back link in every article lead to the overview as well. */
  @media (max-width: 29.99rem) {
    .all.has-lang { display: none; }
  }
  nav a:hover {
    color: var(--c-header-text);
    background: var(--c-signal);
  }
  .lang { letter-spacing: 0.06em; }
  .repo svg { width: 1.25rem; height: 1.25rem; }
  /* Icon only on narrow phones, so the bar fits at 360 px. */
  .repo-label { display: none; }
  @media (min-width: 30rem) {
    .repo-label { display: inline; }
  }
</style>
