---
/**
 * The four officials' signals a player has to read during play, as stick figures:
 * arm up, arms crossed (icing), arm towards the blue line (offside called) and the
 * wash-out. A gesture is easier to remember from a picture than from a table row.
 * After the IIHF rule book 2026/27, Appendix I.
 *
 * The signalling arms are drawn in the brand colour, the rest of the figure in the text
 * colour. The meaning is in the caption; the drawings are decoration for screen readers.
 * Static: no JavaScript.
 */
import { localeFromUrl } from '../lib/i18n';

const de = {
  caption: 'Die Zeichen auf einen Blick',
  signals: {
    up: { name: 'Arm hoch', meaning: 'Linienrichter: verzögertes Abseits oder mögliches Icing. Schiedsrichter: angezeigte Strafe.' },
    crossed: { name: 'Arme vor der Brust verschränkt', meaning: 'Icing.' },
    point: { name: 'Arm zeigt zur blauen Linie', meaning: 'Abseits. Bully vor der blauen Linie.' },
    washout: { name: 'Arme seitlich, hin und her', meaning: 'Aufgehoben: kein Abseits, kein Icing oder kein Tor.' },
  },
};
const en: typeof de = {
  caption: 'The signals at a glance',
  signals: {
    up: { name: 'Arm up', meaning: 'Linesperson: delayed offside or possible icing. Referee: delayed penalty.' },
    crossed: { name: 'Arms folded across the chest', meaning: 'Icing.' },
    point: { name: 'Arm points at the blue line', meaning: 'Offside. Faceoff outside the blue line.' },
    washout: { name: 'Arms out to the sides, swung', meaning: 'Washed out: no offside, no icing or no goal.' },
  },
};

const s = { de, en }[localeFromUrl(Astro.url)];

/* Each figure: the signalling arms as polylines in a 40 × 60 box. Shoulders at (20, 18). */
const figures = [
  { key: 'up', arms: ['20,18 25,15 26,0'], rest: ['20,18 13,31'] },
  { key: 'crossed', arms: ['20,18 11,24 27,30', '20,18 29,24 13,30'], rest: [] },
  { key: 'point', arms: ['20,18 38,18'], rest: ['20,18 13,31'] },
  { key: 'washout', arms: ['20,18 2,18', '20,18 38,18'], rest: [], swing: true },
] as const;
---

<figure class="signals">
  <figcaption>{s.caption}</figcaption>
  <ul>
    {
      figures.map((f) => (
        <li>
          <svg viewBox="0 0 40 60" aria-hidden="true">
            <circle cx="20" cy="9" r="4.5" class="body" />
            <polyline points="20,14 20,35" class="body" />
            <polyline points="14,53 20,35 26,53" class="body" />
            {f.rest.map((p) => <polyline points={p} class="body" />)}
            {f.arms.map((p) => <polyline points={p} class="arm" />)}
            {'swing' in f && (
              <>
                <path d="M2 13 q3 -3 6 0" class="swing" />
                <path d="M32 13 q3 -3 6 0" class="swing" />
              </>
            )}
          </svg>
          <p>
            <strong>{s.signals[f.key].name}</strong>
            <span>{s.signals[f.key].meaning}</span>
          </p>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .signals {
    margin: var(--s-6) 0;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  figcaption {
    margin-bottom: var(--s-4);
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    font-weight: 700;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* .prose spaces consecutive list items; ul > li outranks it. */
  ul > li {
    margin: 0;
  }

  svg {
    display: block;
    width: 4.5rem;
    height: auto;
    margin: 0 auto var(--s-2);
  }
  .body,
  .arm,
  .swing {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .body {
    stroke: var(--c-text);
    stroke-width: 2.4;
  }
  .arm {
    stroke: var(--c-brand);
    stroke-width: 3;
  }
  .swing {
    stroke: var(--c-brand);
    stroke-width: 1.2;
    stroke-dasharray: 1.5 1.5;
  }

  p {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    font-size: var(--t-sm);
    text-align: center;
  }
  span {
    color: var(--c-text-muted);
  }
</style>
