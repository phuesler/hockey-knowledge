---
import BaseLayout from './BaseLayout.astro';
import { href } from '../lib/href';
import { t, type Locale } from '../lib/i18n';
import type { Alternate } from '../lib/articles';
import type { MarkdownHeading } from 'astro';

interface NavLink { title: string; path: string }

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path: string;
  /** Every language version of this article, for the switcher and hreflang. */
  alternates?: Alternate[];
  updated: Date;
  tags?: string[];
  readingMinutes: number;
  headings: MarkdownHeading[];
  prev?: NavLink;
  next?: NavLink;
}

const {
  title, description, locale = 'de', path, alternates, updated, tags = [],
  readingMinutes, headings, prev, next,
} = Astro.props;

const s = t(locale);
// Only h2s go in the table of contents; h3s would make it unreadable on a phone.
const toc = headings.filter((h) => h.depth === 2);
const updatedLabel = updated.toLocaleDateString(s.dateLocale, {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={title} description={description} locale={locale} path={path} alternates={alternates}>
  <article class="wrap">
    <header class="article-head">
      <a class="back" href={href(`/${locale}/`)}>&larr; {s.backToOverview}</a>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta">
        <span>{s.updatedOn} {updatedLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} {s.readingTime}</span>
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label={s.topics}>
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}
    </header>

    {toc.length > 2 && (
      <nav class="toc card" aria-labelledby="toc-title">
        <h2 id="toc-title">{s.inThisArticle}</h2>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label={s.moreArticles}>
        {prev && (
          <a class="card pager-link" href={href(prev.path)}>
            <span>{s.previous}</span>
            <strong>{prev.title}</strong>
          </a>
        )}
        {next && (
          <a class="card pager-link next" href={href(next.path)}>
            <span>{s.next}</span>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  article { padding-block: var(--s-6) var(--s-7); }

  .back {
    display: inline-block;
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
    margin-block-end: var(--s-4);
  }
  .back:hover { text-decoration: underline; }

  h1 { font-size: var(--t-h1); letter-spacing: -0.02em; }

  .lede {
    font-size: var(--t-lg);
    color: var(--c-text-muted);
    margin-block-start: var(--s-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--c-text-muted);
    margin-block-start: var(--s-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-3);
  }

  .article-head {
    padding-block-end: var(--s-5);
    border-block-end: 1px solid var(--c-border);
  }

  .toc {
    margin-block: var(--s-6);
    padding: var(--s-4) var(--s-5);
  }
  .toc h2 {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
  }
  .toc ol {
    margin-block-start: var(--s-3);
    padding-inline-start: 1.3em;
  }
  .toc li + li { margin-block-start: var(--s-2); }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .prose { margin-block-start: var(--s-6); }

  .pager {
    display: grid;
    gap: var(--s-4);
    margin-block-start: var(--s-8);
  }
  @media (min-width: 40rem) {
    .pager { grid-template-columns: 1fr 1fr; }
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .pager-link:hover {
    border-color: var(--c-brand);
    transform: translateY(-2px);
  }
  .pager-link span {
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }
  .pager-link strong { color: var(--c-brand); }
  .pager-link.next { text-align: end; }
</style>
